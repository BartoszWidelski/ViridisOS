# ================================

# ViridisOS .gitignore

# Scope: OS development, toolchain, Docker, build artifacts

# ================================

# ---- Build artifacts ----

build/
**/build/
*.o
*.a
*.elf
*.bin
*.iso
*.img
*.map

# ---- Toolchain artifacts ----

/tools/toolchain/build-*/
/tools/toolchain/src/
/tmp/

# ---- Generated kernel / bootloader outputs ----

/kernel.bin
/boot.bin

# ---- Debugging & logs ----

*.log
*.dump
qemu.log

# ---- Docker ----

**/.docker

# ---- IDE / Editor ----

.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS-specific ----

.DS_Store
Thumbs.db

# ---- Python cache (tools) ----

**pycache**/
*.pyc

# ---- CMake / Autotools (future-proof) ----

CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# ---- Misc ----

*.tmp
*.bak